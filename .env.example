# Upstash Redis (created via Vercel Marketplace — these two are set automatically
# when you connect the store to the project; copy them here for local dev)
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-token

# Anthropic API key for /api/parse (server-side only; never shipped to the client)
ANTHROPIC_API_KEY=sk-ant-...

# The board's unguessable URL segment. Generate something long and random, e.g.:
#   node -e "console.log(crypto.randomUUID())"
BOARD_ID=some-long-unguessable-id

# Shared passcode both of you type once per device. Thin protection by design.
# At least 12 characters (the server refuses shorter ones), since nothing rate-limits wrong guesses.
BOARD_PASSCODE=pick-a-passcode

# --- Optional ---

# "demo" runs the public demo: no passcode, no Redis, boards live in each visitor's
# browser and the board API 404s. In demo mode BOARD_ID, BOARD_PASSCODE and the KV_*
# vars aren't used; use a separate Anthropic workspace key with a spend cap.
# Unset or "real" (the default) is the passcode-gated shared board.
# BURNOFF_MODE=demo

# Overrides the parse model (default: PARSE_MODEL in lib/parse-schema.ts), in either mode.
# PARSE_MODEL=claude-sonnet-5
